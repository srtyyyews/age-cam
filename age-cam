<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Trap Kitty Age</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500&family=Press+Start+2P&display=swap');

body {
  margin: 0;
  background: linear-gradient(180deg, #000000, #1a001f);
  color: #ff9ad5;
  font-family: 'Orbitron', sans-serif;
  text-align: center;
  overflow-x: hidden;
}

h2 {
  font-family: 'Press Start 2P', cursive;
  font-size: 14px;
  margin: 12px 0;
  color: #ff5fcf;
  text-shadow: 0 0 10px #ff5fcf;
}

.container {
  position: relative;
  max-width: 420px;
  margin: auto;
}

video {
  width: 100%;
  border-radius: 16px;
  transform: scaleX(-1);
  border: 2px solid #ff5fcf;
  box-shadow: 0 0 20px #ff5fcf;
}

#age {
  margin-top: 12px;
  font-size: 22px;
  color: #fff;
  text-shadow: 0 0 10px #ff5fcf;
}

.kitty {
  position: absolute;
  top: -18px;
  right: -10px;
  font-size: 32px;
  filter: drop-shadow(0 0 6px #ff5fcf);
}

.footer {
  margin-top: 10px;
  font-size: 12px;
  opacity: 0.7;
}
</style>
</head>

<body>

<h2>TRAP KITTY AGE</h2>

<div class="container">
  <div class="kitty">🎀😈</div>
  <video id="video" autoplay muted playsinline></video>
</div>

<div id="age">загрузка нейросети…</div>
<div class="footer">yung vibe × kawaii hell</div>

<script src="https://unpkg.com/face-api.js@0.22.2/dist/face-api.min.js"></script>

<script>
const video = document.getElementById("video");
const ageText = document.getElementById("age");

async function startCamera() {
  const stream = await navigator.mediaDevices.getUserMedia({
    video: { facingMode: "user" }
  });
  video.srcObject = stream;
}

async function loadModels() {
  const url = "https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/weights";
  await faceapi.nets.tinyFaceDetector.loadFromUri(url);
  await faceapi.nets.ageGenderNet.loadFromUri(url);
}

async function detectAge() {
  const result = await faceapi
    .detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
    .withAgeAndGender();

  if (result) {
    const age = Math.round(result.age);
    ageText.innerText = `😈🎀 ${age} лет 🎀😈`;
  } else {
    ageText.innerText = "лица нет — не трап";
  }
}

(async () => {
  await loadModels();
  await startCamera();
  ageText.innerText = "сканирую вайб…";
  setInterval(detectAge, 1200);
})();
</script>

</body>
</html>
